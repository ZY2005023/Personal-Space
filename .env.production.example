# Copy outside Git (for example deploy/production.env) and edit.
# Never commit real secrets. Use `docker compose --env-file <file>` so the
# compose file can also read SITE_DOMAIN and APP_VERSION.

APP_VERSION=2026.11.06
SITE_DOMAIN=example.com

# PostgreSQL owner used by migrations, and the least-privilege runtime role.
POSTGRES_USER=ps_owner
POSTGRES_PASSWORD=
POSTGRES_DB=personal_space
APP_DATABASE_PASSWORD=
DATABASE_URL=postgresql://ps_app:CHANGE_ME@db:5432/personal_space?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://ps_owner:CHANGE_ME@db:5432/personal_space?sslmode=disable

# Public origin. Must exactly match the browser origin, including scheme.
AUTH_URL=https://example.com
# openssl rand -hex 32
AUTH_SECRET=
# Independent pagination signing key. openssl rand -hex 32
CURSOR_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Existing private S3-compatible bucket. This project never creates it.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Private paths inside the application container.
EXPORT_DIRECTORY=/data/exports
EXPORT_MAX_BYTES=67108864
EXPORT_TTL_SECONDS=86400

BACKUP_DIRECTORY=/data/backups
BACKUP_MAX_BYTES=10737418240
BACKUP_TIMEOUT_SECONDS=1800
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
RESTIC_PATH=restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/run/secrets/restic_password

# Explicit opt-in only. Retention counts and RPO/RTO require an operator decision.
BACKUP_AUTOMATIC=false
BACKUP_TIME=03:00
# Leave empty until a retention decision is made; enabling the gc profile without it fails fast.
MEDIA_GC_GRACE_SECONDS=

# S3 or restic provider credentials for the offsite repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Independent targets for restore drills. Create them before use.
RESTORE_DATABASE_URL=
RESTORE_S3_BUCKET=
RESTORE_S3_REGION=
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=
RESTORE_S3_ENDPOINT=
RESTORE_S3_FORCE_PATH_STYLE=false