{
  "name": "personal-space",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:smoke": "node scripts/smoke.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:git-sync": "node --test tests/git-sync.test.mjs",
    "git:sync": "node scripts/sync-git.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "worker:media": "tsx scripts/media-worker.ts",
    "backup:drill": "tsx scripts/restore-drill.ts",
    "worker:gc": "tsx scripts/media-gc-worker.ts",
    "worker:backup": "tsx scripts/backup-worker.ts",
    "worker:export": "tsx scripts/export-worker.ts",
    "worker:outbox": "tsx scripts/outbox-worker.ts",
    "admin:init": "tsx scripts/admin-init.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@next/env": "16.4.4",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.4",
    "next-auth": "4.24.15",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  }
}
