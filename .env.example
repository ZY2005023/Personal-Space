# Copy to .env.local. No live service is created by this project.
# Keep all secret values outside source control.
DATABASE_URL=
AUTH_SECRET=
# Independent public pagination signing key. Required for production pagination.
CURSOR_SECRET=
# 32-byte base64 key for AES-256-GCM TOTP secrets.
TOTP_ENCRYPTION_KEY=
AUTH_URL=http://127.0.0.1:3000
# Optional local-only, read-only public content preview. Never enables admin access.
PREVIEW_CONTENT=false
# Existing private S3-compatible bucket only. This app never creates a bucket.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional HTTPS endpoint for an S3-compatible provider.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Private local export directory (absolute path, outside public/). Created only by the worker.
EXPORT_DIRECTORY=
# Configurable engineering defaults, not backup retention policy.
EXPORT_MAX_BYTES=67108864
EXPORT_TTL_SECONDS=86400

# Existing private backup directory and installed tools; never initialized automatically.
BACKUP_DIRECTORY=
BACKUP_MAX_BYTES=10737418240
BACKUP_TIMEOUT_SECONDS=1800
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
RESTIC_PATH=restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=

# Explicit opt-in to scheduled daily/weekly/monthly/yearly backups. No automatic deletion.
BACKUP_AUTOMATIC=false
BACKUP_TIME=03:00
# Required to enable physical media cleanup; no default retention period is assumed.
MEDIA_GC_GRACE_SECONDS=

# Optional isolated restore drill targets. --execute is required; no targets are created.
RESTORE_DATABASE_URL=
RESTORE_S3_BUCKET=
RESTORE_S3_REGION=
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=
RESTORE_S3_ENDPOINT=
RESTORE_S3_FORCE_PATH_STYLE=false

# If the existing restic repository uses S3, configure its independent provider credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 迁移专用所有者连接；应用仍使用权限较低的DATABASE_URL
MIGRATION_DATABASE_URL=
# 本机HTTPS测试CA绝对路径，须在Node进程启动前设置
NODE_EXTRA_CA_CERTS=
