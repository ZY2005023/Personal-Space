// Model definitions only. No migration or database has been created.
// PostgreSQL-only constraints in prisma/CONSTRAINTS.md still require reviewed SQL.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                      String              @id @default(uuid()) @db.Uuid
  singletonKey            Int                 @unique @default(1) @map("singleton_key")
  username                String              @unique @db.VarChar(100)
  passwordHash            String              @map("password_hash")
  mfaEnabled              Boolean             @default(false) @map("mfa_enabled")
  totpSecretEncrypted     String?             @map("totp_secret_encrypted")
  lastTotpStep            BigInt?             @map("last_totp_step")
  sessionVersion          Int                 @default(1) @map("session_version")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  recoveryCodes           RecoveryCode[]
  contents                Content[]
  media_uploader          Media[]             @relation("Media_uploader")
  idempotencyRecord_admin IdempotencyRecord[] @relation("IdempotencyRecord_admin")
  auditLog_actor          AuditLog[]          @relation("AuditLog_actor")
  systemSetting_admin     SystemSetting[]     @relation("SystemSetting_admin")

  @@map("admin_users")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([adminId, codeHash])
  @@map("admin_recovery_codes")
}

model LoginThrottle {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  @@map("login_throttles")
}

model Content {
  id                            String                  @id @default(uuid()) @db.Uuid
  ownerId                       String                  @map("owner_id") @db.Uuid
  type                          String                  @db.VarChar(20)
  module                        String                  @db.VarChar(20)
  publicationState              String                  @default("NEVER_PUBLISHED") @map("publication_state")
  effectiveVisibility           String                  @default("PRIVATE") @map("effective_visibility")
  stateVersion                  Int                     @default(1) @map("state_version")
  publishedRevisionId           String?                 @map("published_revision_id") @db.Uuid
  firstPublishedAt              DateTime?               @map("first_published_at") @db.Timestamptz(3)
  lastPublishedAt               DateTime?               @map("last_published_at") @db.Timestamptz(3)
  deletedAt                     DateTime?               @map("deleted_at") @db.Timestamptz(3)
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                         AdminUser               @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  draft                         ContentDraft?
  revisions                     ContentRevision[]       @relation("Revisions")
  publishedRevision             ContentRevision?        @relation("Published", fields: [id, publishedRevisionId], references: [contentId, id], onDelete: Restrict, onUpdate: Restrict)
  publication                   ContentPublication?
  routes                        ContentRoute[]
  contentMedia_parent           ContentMedia[]          @relation("ContentMedia_parent")
  contentTag_parent             ContentTag[]            @relation("ContentTag_parent")
  contentSearchDocument_content ContentSearchDocument[] @relation("ContentSearchDocument_content")

  @@index([type, module, updatedAt, id])
  @@index([deletedAt])
  @@map("contents")
}

model ContentDraft {
  contentId            String           @id @map("content_id") @db.Uuid
  draftPayload         Json             @map("draft_payload")
  payloadSchemaVersion Int              @default(1) @map("payload_schema_version")
  revisionNumber       Int              @default(1) @map("revision_number")
  basedOnRevisionId    String?          @map("based_on_revision_id") @db.Uuid
  lastSavedAt          DateTime         @default(now()) @map("last_saved_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  content              Content          @relation(fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  basedOn              ContentRevision? @relation("ContentDraft_basedOn", fields: [contentId, basedOnRevisionId], references: [contentId, id], onDelete: Restrict, onUpdate: Restrict)
  draftMedia_parent    DraftMedia[]     @relation("DraftMedia_parent")
  draftCategory_parent DraftCategory[]  @relation("DraftCategory_parent")
  draftTag_parent      DraftTag[]       @relation("DraftTag_parent")

  @@map("content_drafts")
}

model ContentRevision {
  id                             String                  @id @default(uuid()) @db.Uuid
  contentId                      String                  @map("content_id") @db.Uuid
  versionNumber                  Int                     @map("version_number")
  publishedEditionNumber         Int?                    @map("published_edition_number")
  revisionKind                   String                  @map("revision_kind")
  snapshot                       Json
  snapshotSchemaVersion          Int                     @default(1) @map("snapshot_schema_version")
  restoredFromRevisionId         String?                 @map("restored_from_revision_id") @db.Uuid
  createdAt                      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  content                        Content                 @relation("Revisions", fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pointedBy                      Content[]               @relation("Published")
  contentDraft_basedOn           ContentDraft[]          @relation("ContentDraft_basedOn")
  restoredFrom                   ContentRevision?        @relation("ContentRevision_restoredFrom", fields: [contentId, restoredFromRevisionId], references: [contentId, id], onDelete: Restrict, onUpdate: Restrict)
  contentRevision_restoredFrom   ContentRevision[]       @relation("ContentRevision_restoredFrom")
  contentPublication_revision    ContentPublication[]    @relation("ContentPublication_revision")
  revisionMedia_parent           RevisionMedia[]         @relation("RevisionMedia_parent")
  revisionCategory_parent        RevisionCategory[]      @relation("RevisionCategory_parent")
  revisionTag_parent             RevisionTag[]           @relation("RevisionTag_parent")
  contentSearchDocument_revision ContentSearchDocument[] @relation("ContentSearchDocument_revision")

  @@unique([contentId, id])
  @@unique([contentId, versionNumber])
  @@unique([contentId, publishedEditionNumber])
  @@map("content_revisions")
}

model ContentPublication {
  contentId    String          @id @map("content_id") @db.Uuid
  revisionId   String          @map("revision_id") @db.Uuid
  title        String          @db.VarChar(240)
  summary      String?
  categoryId   String?         @map("category_id") @db.Uuid
  coverMediaId String?         @map("cover_media_id") @db.Uuid
  publishedAt  DateTime        @map("published_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  content      Content         @relation(fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision     ContentRevision @relation("ContentPublication_revision", fields: [contentId, revisionId], references: [contentId, id], onDelete: Restrict, onUpdate: Restrict)
  category     Category?       @relation("ContentPublication_category", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cover        Media?          @relation("ContentPublication_cover", fields: [coverMediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([publishedAt, contentId])
  @@map("content_publications")
}

model ContentRoute {
  id        String   @id @default(uuid()) @db.Uuid
  path      String   @unique
  contentId String?  @map("content_id") @db.Uuid
  routeKind String   @map("route_kind")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([contentId, routeKind])
  @@map("content_routes")
}

model Category {
  id                          String               @id @default(uuid()) @db.Uuid
  module                      String
  parentId                    String?              @map("parent_id") @db.Uuid
  name                        String               @db.VarChar(100)
  normalizedName              String               @map("normalized_name")
  slug                        String               @db.VarChar(120)
  sortOrder                   Int                  @default(0) @map("sort_order")
  isSystem                    Boolean              @default(false) @map("is_system")
  deletedAt                   DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  contentPublication_category ContentPublication[] @relation("ContentPublication_category")
  parent                      Category?            @relation("Category_parent", fields: [module, parentId], references: [module, id], onDelete: Restrict, onUpdate: Restrict)
  category_parent             Category[]           @relation("Category_parent")
  draftCategory_category      DraftCategory[]      @relation("DraftCategory_category")
  revisionCategory_category   RevisionCategory[]   @relation("RevisionCategory_category")

  @@unique([module, id])
  @@unique([module, parentId, slug])
  @@unique([module, parentId, normalizedName])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(100)
  normalizedName  String        @unique @map("normalized_name")
  slug            String        @unique @db.VarChar(120)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  draftTag_tag    DraftTag[]    @relation("DraftTag_tag")
  revisionTag_tag RevisionTag[] @relation("RevisionTag_tag")
  contentTag_tag  ContentTag[]  @relation("ContentTag_tag")

  @@map("tags")
}

model Media {
  id                       String               @id @default(uuid()) @db.Uuid
  storageProvider          String               @map("storage_provider")
  storageKey               String               @map("storage_key")
  originalFilename         String               @map("original_filename")
  mimeType                 String               @map("mime_type")
  sizeBytes                BigInt               @map("size_bytes")
  checksumSha256           String               @map("checksum_sha256")
  width                    Int?
  height                   Int?
  capturedAt               DateTime?            @map("captured_at") @db.Timestamptz(3)
  captureTimeTrusted       Boolean              @default(false) @map("capture_time_trusted")
  uploadedAt               DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  processingStatus         String               @map("processing_status")
  uploadedBy               String               @map("uploaded_by") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt                DateTime?            @map("deleted_at") @db.Timestamptz(3)
  contentPublication_cover ContentPublication[] @relation("ContentPublication_cover")
  uploader                 AdminUser            @relation("Media_uploader", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaVariant_media       MediaVariant[]       @relation("MediaVariant_media")
  draftMedia_media         DraftMedia[]         @relation("DraftMedia_media")
  revisionMedia_media      RevisionMedia[]      @relation("RevisionMedia_media")
  contentMedia_media       ContentMedia[]       @relation("ContentMedia_media")

  @@unique([storageProvider, storageKey])
  @@map("media")
}

model IdempotencyRecord {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  operationScope    String    @map("operation_scope")
  idempotencyKey    String    @map("idempotency_key")
  requestHash       String    @map("request_hash")
  status            String
  responseStatus    Int?      @map("response_status")
  responseReference Json?     @map("response_reference")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  admin             AdminUser @relation("IdempotencyRecord_admin", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([adminId, operationScope, idempotencyKey])
  @@map("idempotency_records")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String    @map("actor_id") @db.Uuid
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  metadata   Json
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      AdminUser @relation("AuditLog_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt, id])
  @@map("audit_logs")
}

model MediaVariant {
  id                String   @id @default(uuid()) @db.Uuid
  mediaId           String   @map("media_id") @db.Uuid
  variantType       String   @map("variant_type") @db.VarChar(20)
  processingVersion Int      @map("processing_version")
  storageKey        String   @unique @map("storage_key")
  mimeType          String   @map("mime_type") @db.VarChar(100)
  width             Int
  height            Int
  sizeBytes         BigInt   @map("size_bytes")
  metadataSanitized Boolean  @map("metadata_sanitized")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  media             Media    @relation("MediaVariant_media", fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([mediaId, variantType, processingVersion])
  @@index([mediaId, variantType, isActive])
  @@map("media_variants")
}

model DraftMedia {
  id          String       @id @default(uuid()) @db.Uuid
  contentId   String       @map("content_id") @db.Uuid
  placementId String       @map("placement_id") @db.Uuid
  mediaId     String       @map("media_id") @db.Uuid
  role        String       @db.VarChar(24)
  sortOrder   Int          @map("sort_order")
  caption     String?
  altText     String       @default("") @map("alt_text")
  parent      ContentDraft @relation("DraftMedia_parent", fields: [contentId], references: [contentId], onDelete: Restrict, onUpdate: Restrict)
  media       Media        @relation("DraftMedia_media", fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([contentId, placementId])
  @@unique([contentId, sortOrder])
  @@index([mediaId])
  @@index([contentId, role, sortOrder])
  @@map("draft_media")
}

model RevisionMedia {
  id          String          @id @default(uuid()) @db.Uuid
  revisionId  String          @map("revision_id") @db.Uuid
  placementId String          @map("placement_id") @db.Uuid
  mediaId     String          @map("media_id") @db.Uuid
  role        String          @db.VarChar(24)
  sortOrder   Int             @map("sort_order")
  caption     String?
  altText     String          @default("") @map("alt_text")
  parent      ContentRevision @relation("RevisionMedia_parent", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media       Media           @relation("RevisionMedia_media", fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, placementId])
  @@unique([revisionId, sortOrder])
  @@index([mediaId])
  @@index([revisionId, role, sortOrder])
  @@map("revision_media")
}

model ContentMedia {
  id          String  @id @default(uuid()) @db.Uuid
  contentId   String  @map("content_id") @db.Uuid
  placementId String  @map("placement_id") @db.Uuid
  mediaId     String  @map("media_id") @db.Uuid
  role        String  @db.VarChar(24)
  sortOrder   Int     @map("sort_order")
  caption     String?
  altText     String  @default("") @map("alt_text")
  parent      Content @relation("ContentMedia_parent", fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media       Media   @relation("ContentMedia_media", fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([contentId, placementId])
  @@unique([contentId, sortOrder])
  @@index([mediaId])
  @@index([contentId, role, sortOrder])
  @@map("content_media")
}

model DraftCategory {
  contentId  String       @id @map("content_id") @db.Uuid
  categoryId String       @map("category_id") @db.Uuid
  parent     ContentDraft @relation("DraftCategory_parent", fields: [contentId], references: [contentId], onDelete: Restrict, onUpdate: Restrict)
  category   Category     @relation("DraftCategory_category", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([categoryId])
  @@map("draft_categories")
}

model RevisionCategory {
  revisionId String          @id @map("revision_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  parent     ContentRevision @relation("RevisionCategory_parent", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category   Category        @relation("RevisionCategory_category", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([categoryId])
  @@map("revision_categories")
}

model DraftTag {
  contentId String       @map("content_id") @db.Uuid
  tagId     String       @map("tag_id") @db.Uuid
  parent    ContentDraft @relation("DraftTag_parent", fields: [contentId], references: [contentId], onDelete: Restrict, onUpdate: Restrict)
  tag       Tag          @relation("DraftTag_tag", fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("draft_tags")
}

model RevisionTag {
  revisionId String          @map("revision_id") @db.Uuid
  tagId      String          @map("tag_id") @db.Uuid
  parent     ContentRevision @relation("RevisionTag_parent", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tag        Tag             @relation("RevisionTag_tag", fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, tagId])
  @@index([tagId])
  @@map("revision_tags")
}

model ContentTag {
  contentId String  @map("content_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  parent    Content @relation("ContentTag_parent", fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tag       Tag     @relation("ContentTag_tag", fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

model ContentSearchDocument {
  contentId      String          @id @map("content_id") @db.Uuid
  revisionId     String          @map("revision_id") @db.Uuid
  title          String
  summary        String
  searchableText String          @map("searchable_text")
  categoryText   String          @map("category_text")
  tagsText       String          @map("tags_text")
  module         String          @db.VarChar(20)
  contentType    String          @map("content_type") @db.VarChar(20)
  publishedAt    DateTime        @map("published_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  content        Content         @relation("ContentSearchDocument_content", fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision       ContentRevision @relation("ContentSearchDocument_revision", fields: [contentId, revisionId], references: [contentId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([module, contentType, publishedAt, contentId])
  @@map("content_search_documents")
}

model OperationJob {
  id            String     @id @default(uuid()) @db.Uuid
  jobType       String     @map("job_type") @db.VarChar(32)
  status        String     @default("PENDING") @db.VarChar(20)
  payload       Json
  result        Json?
  attempts      Int        @default(0)
  nextAttemptAt DateTime?  @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil    DateTime?  @map("lease_until") @db.Timestamptz(3)
  leaseToken    String?    @map("lease_token") @db.Uuid
  errorCode     String?    @map("error_code") @db.VarChar(100)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt     DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(3)
  backup        BackupRun?

  @@index([status, nextAttemptAt])
  @@map("operation_jobs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken    String?   @map("lease_token") @db.Uuid
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model BackupRun {
  id               String         @id @default(uuid()) @db.Uuid
  jobId            String         @unique @map("job_id") @db.Uuid
  backupType       String         @map("backup_type") @db.VarChar(20)
  status           String         @default("PENDING") @db.VarChar(20)
  localStatus      String         @default("PENDING") @map("local_status") @db.VarChar(20)
  integrityStatus  String         @default("PENDING") @map("integrity_status") @db.VarChar(20)
  offsiteStatus    String         @default("PENDING") @map("offsite_status") @db.VarChar(20)
  manifestPath     String?        @map("manifest_path")
  checksum         String?        @db.VarChar(64)
  sizeBytes        BigInt?        @map("size_bytes")
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(3)
  verifiedAt       DateTime?      @map("verified_at") @db.Timestamptz(3)
  errorSummary     String?        @map("error_summary")
  job              OperationJob   @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  backupCopy_run   BackupCopy[]   @relation("BackupCopy_run")
  restoreDrill_run RestoreDrill[] @relation("RestoreDrill_run")

  @@index([backupType, startedAt])
  @@map("backup_runs")
}

model BackupCopy {
  id           String    @id @default(uuid()) @db.Uuid
  backupRunId  String    @map("backup_run_id") @db.Uuid
  copyType     String    @map("copy_type") @db.VarChar(20)
  locationKey  String    @map("location_key")
  status       String    @default("PENDING") @db.VarChar(20)
  checksum     String?   @db.VarChar(64)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)
  errorSummary String?   @map("error_summary")
  run          BackupRun @relation("BackupCopy_run", fields: [backupRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([backupRunId, copyType, locationKey])
  @@map("backup_copies")
}

model RestoreDrill {
  id                  String    @id @default(uuid()) @db.Uuid
  backupRunId         String    @map("backup_run_id") @db.Uuid
  status              String    @db.VarChar(20)
  startedAt           DateTime  @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  verificationSummary Json      @map("verification_summary")
  notes               String?
  run                 BackupRun @relation("RestoreDrill_run", fields: [backupRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("restore_drills")
}

model SystemSetting {
  settingKey   String     @id @map("setting_key") @db.VarChar(100)
  settingValue Json       @map("setting_value")
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String?    @map("updated_by") @db.Uuid
  admin        AdminUser? @relation("SystemSetting_admin", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("system_settings")
}
